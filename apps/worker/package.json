{
  "name": "@nutrirace/worker",
  "version": "0.1.0",
  "private": true,
  "description": "NutriRace background job worker (BullMQ).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@nutrirace/shared": "workspace:*",
    "bullmq": "^5.58.0",
    "ioredis": "^5.8.0"
  },
  "devDependencies": {
    "@nutrirace/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
