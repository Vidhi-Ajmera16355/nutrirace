
NODE_ENV=development

# --- Public URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
API_PREFIX=api
API_PORT=4000
# Comma-separated extra CORS origins (defaults to FRONTEND_URL). Wildcards are rejected.
CORS_ORIGINS=

# --- Data stores ---
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local MongoDB:   mongodb://localhost:27017/<dbname>
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nutrirace
REDIS_URL=redis://localhost:6379

# --- Security ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=change_me_generate_a_random_value_of_at_least_32_chars
TRUST_PROXY=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
# Defaults to true outside production, false in production.
SWAGGER_ENABLED=

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- Worker ---
WORKER_HEALTH_PORT=4001
WORKER_CONCURRENCY=5

# --- Web (browser-visible; must NEVER contain secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
